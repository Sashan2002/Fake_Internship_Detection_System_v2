# Django
SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - the React dev server's origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model paths (populated after training)
